<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du widget « Aujourd'hui » dans le sélecteur de widgets (Android 12 et plus), en clair ou en sombre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_title"
                android:textColor="@color/widget_preview_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_summary"
                android:textColor="@color/widget_preview_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_streak"
            android:textColor="@color/widget_preview_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/WidgetPreviewItem"
        android:layout_marginTop="10dp"
        android:text="@string/widget_preview_item_1" />

    <TextView
        style="@style/WidgetPreviewItem"
        android:text="@string/widget_preview_item_2" />

    <TextView
        style="@style/WidgetPreviewItem"
        android:text="@string/widget_preview_item_3" />
</LinearLayout>
