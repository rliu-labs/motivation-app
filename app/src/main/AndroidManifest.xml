<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lecture des pas dans Health Connect -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Sommeil et séances de sport, pour cocher les habitudes correspondantes (réglage facultatif) -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- Capteur de pas du téléphone (secours) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Rappels du matin et du soir (demandée seulement quand on les active) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".SentierApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sentier">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Explication de l'usage des données de santé, demandée par Health Connect -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Widgets de l'écran d'accueil. Les boutons des widgets passent par le récepteur privé de Glance. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.StepsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_steps_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info" />
        </receiver>

        <!-- Bouton « Fait » des notifications : privé à l'appli -->
        <receiver
            android:name=".notify.ReminderActionReceiver"
            android:exported="false" />
    </application>
</manifest>
